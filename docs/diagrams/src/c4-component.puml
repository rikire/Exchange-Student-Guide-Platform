@startuml c4-component
' C4 level 3 — the slices inside the web application.
' The slice list is docs/ai/architecture-rules.md; the boundary rule is ADR-0002. Only two channels
' cross a slice boundary — a published type, or a Spring ApplicationEvent — so an arrow here is one
' of those and never a direct call into another slice's service or repository.
'
' Every slice is built (11 Oct 2026), so nothing is dashed. The arrows between slices are the ones
' c4-component-actual draws from the imports, each with what crosses it; the search index needs no
' arrow from another slice, because Hibernate Search updates it from the Article entity on commit.
!pragma layout smetana
!include <C4/C4_Component>

title Exchange Student Guide — slices inside the web application (C4 level 3)

Container_Boundary(web, "Web application") {
  Component(home, "home", "slice", "Landing page: pinned articles, recent articles, tag list, search entry (FR-009, FR-025)")
  Component(articleview, "articleview", "slice", "Reading a published article (FR-001)")
  Component(search, "search", "slice", "Indexing and querying; the index is rebuilt at every start (FR-007, ADR-0004)")
  Component(taxonomy, "taxonomy", "slice", "Tags, and browsing by tag. Owns tag creation and normalisation (FR-008, ADR-0005)")
  Component(contribute, "contribute", "slice", "New articles, proposed edits, status lookup (FR-010 to FR-012)")
  Component(moderate, "moderate", "slice", "The queue, approval, rejection, revisions, removal, direct publishing (FR-014 to FR-020, FR-023, FR-024, FR-026)")
  Component(report, "report", "slice", "Flagging an article, and closing the flag (FR-021, FR-022)")
  Component(media, "media", "slice", "Upload, storage, safe delivery (FR-016)")
  Component(wikilink, "wikilink", "plain Java", "The ~[~[link]] parser and renderer. No Spring, no JPA — so its tests run without a context (FR-002 to FR-005)")
  Component(backlink, "backlink", "slice", "Owns article_link: re-reads an article's links on ArticleTextChanged, answers what links here (FR-006, ADR-0016)")
  Component(backup, "backup", "slice", "Export and import of the whole knowledge base (NFR-004, ADR-0007)")
  Component(about, "about", "slice", "The OGE team and developers pages, static: no table, no other slice (FR-035)")

  Component(shared, "shared", "persistence · web · security", "JPA entities and Flyway migrations, layout fragments, CSRF, rate limiting, admin authentication")
}

ContainerDb(db, "Relational database")
ContainerDb(index, "Search index")
ContainerDb(mediaroot, "Media root")

' Between slices: only a published type or an ApplicationEvent, never a direct call (ADR-0002).
Rel(articleview, wikilink, "Renders links, resolves red links", "published type")
Rel(articleview, backlink, "Asks what links here", "published type")
Rel(moderate, backlink, "Published or edited — re-read its links", "ApplicationEvent")
Rel(backup, backlink, "Imported — re-read its links", "ApplicationEvent")
Rel(backlink, wikilink, "Finds the links in a body with the page's own parser", "published type")
Rel(home, wikilink, "Builds the path to an article from its address", "published type")
Rel(backup, wikilink, "Derives an article's address from its title on import", "published type")
Rel(contribute, wikilink, "Parses links out of a submission", "published type")
Rel(articleview, taxonomy, "Asks for an article's tags", "published type")
Rel(home, taxonomy, "Asks for the tag list", "published type")
Rel(articleview, media, "Asks for the article's media assets", "published type")
Rel(contribute, media, "Stores an upload against the submission", "published type")
Rel(moderate, media, "Moves media to the article on approval", "published type")
Rel(articleview, search, "Similar titles on a missing article's page", "published type")
Rel(search, taxonomy, "Tag links in the results", "published type")
Rel(search, wikilink, "Addresses of hits; the body read as plain text", "published type")
Rel(taxonomy, wikilink, "Address of each tagged article", "published type")
Rel(report, wikilink, "Address of the reported article", "published type")
Rel(moderate, wikilink, "Addresses; the text as read, for the diff", "published type")
Rel(contribute, taxonomy, "Tags named on a submission", "published type")
Rel(moderate, taxonomy, "Tags adjusted on approval", "published type")
Rel(backup, taxonomy, "Tags of an imported article", "published type")
Rel(moderate, contribute, "Submits the moderator's own article through the same checks (FR-023, FR-024)", "published type")

' To the stores. Each slice declares its own Spring Data repository over the entities in
' shared/persistence — there is no shared repository (ADR-0002). wikilink is the one slice with no
' arrow here: ArchUnit forbids it from importing jakarta.persistence at all.
Rel(home, db, "Pinned and recent articles", "own repository")
Rel(articleview, db, "One published article", "own repository")
Rel(backlink, db, "article_link", "own repository")
Rel(search, db, "Article content, to index", "own repository")
Rel(taxonomy, db, "Tags and article_tag", "own repository")
Rel(contribute, db, "Submissions", "own repository")
Rel(moderate, db, "Queue, approvals, revisions", "own repository")
Rel(report, db, "Reports", "own repository")
Rel(media, db, "Media metadata", "own repository")
Rel(backup, db, "Everything published", "own repository")

Rel(shared, db, "Entities and Flyway migrations", "JPA")
Rel(search, index, "Indexes and queries", "Hibernate Search")
Rel(media, mediaroot, "Writes on upload, streams with Range", "File I/O")
Rel(backup, mediaroot, "Media travels with the export", "File I/O")

SHOW_LEGEND()
@enduml
