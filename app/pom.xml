<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>in.ac.iitm.guide</groupId>
    <artifactId>exchange-student-guide</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>guide-app</artifactId>
  <name>Guide application</name>
  <description>Spring Boot application: the knowledge base itself</description>

  <properties>
    <browser.tests>**/Browser*Test.java</browser.tests>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Read directly by backup's front matter parser; the version is Spring Boot's. -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- The typeface, served from the jar under /webjars/ (ADR-0013, docs/design/reference.md). -->
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>fontsource__noto-sans</artifactId>
      <version>${noto-sans.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- FR-032's photo viewer (ADR-0018): ES modules and a stylesheet, no dependencies of its own. -->
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>photoswipe</artifactId>
      <version>${photoswipe.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The Markdown editor of FR-027 (ADR-0013). dist/easymde.min.js bundles CodeMirror, marked and
         the spell checker, so the WebJars it declares for them, by version range, are left out. -->
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>easymde</artifactId>
      <version>${easymde.version}</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- CSRF on every form (security.md), from FEAT-005; the moderator login (ADR-0009) builds on it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <!-- Flyway 10+ ships each database as its own module; without this one the application
           refuses to start on PostgreSQL ("Unsupported Database"). H2 is built into flyway-core. -->
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.search</groupId>
      <artifactId>hibernate-search-mapper-orm</artifactId>
      <version>${hibernate-search.version}</version>
    </dependency>
    <dependency>
      <groupId>org.hibernate.search</groupId>
      <artifactId>hibernate-search-backend-lucene</artifactId>
      <version>${hibernate-search.version}</version>
    </dependency>

    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark</artifactId>
      <version>${commonmark.version}</version>
    </dependency>
    <!-- GitHub-style tables, which CommonMark itself lacks; same project, version and licence
         (BSD-2-Clause), checked on Maven Central on 2026-09-28. Added by the human's decision. -->
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark-ext-gfm-tables</artifactId>
      <version>${commonmark.version}</version>
    </dependency>

    <!-- FR-029: the paragraphs and words an edit changes, for the moderator's review (ADR-0015).
         Apache-2.0, no runtime dependencies. -->
    <dependency>
      <groupId>io.github.java-diff-utils</groupId>
      <artifactId>java-diff-utils</artifactId>
      <version>${java-diff-utils.version}</version>
    </dependency>

    <!-- FEAT-009: the type of an upload from its bytes, never from its name (security.md).
         Apache-2.0. tika-core only: the detector, not the parsers. -->
    <dependency>
      <groupId>org.apache.tika</groupId>
      <artifactId>tika-core</artifactId>
      <version>${tika.version}</version>
    </dependency>
    <!-- FEAT-009: the EXIF orientation of a phone photo, which re-encoding would otherwise drop and
         leave the photo on its side. Apache-2.0. -->
    <dependency>
      <groupId>com.drewnoakes</groupId>
      <artifactId>metadata-extractor</artifactId>
      <version>${metadata-extractor.version}</version>
    </dependency>
    <!-- FEAT-009: a WebP reader for the JDK's ImageIO, so a WebP photo can be re-encoded. BSD. -->
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-webp</artifactId>
      <version>${twelvemonkeys.version}</version>
    </dependency>

    <!-- NFR-005 (ADR-0019): a token bucket per client address, Bucket4j's, held in a Caffeine cache
         that forgets an address once its window has passed. Caffeine's version is Spring Boot's. -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.vladmihalcea</groupId>
      <artifactId>db-util</artifactId>
      <version>${db-util.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The postgres profile below runs the suite on a throwaway PostgreSQL through this module's JDBC
         URL; the version is Spring Boot's (DEBT-007). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The browser profile below: a real browser at four widths, and axe-core's WCAG checks in it
         (ADR-0014, NFR-007, NFR-008). -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.deque.html.axe-core</groupId>
      <artifactId>playwright</artifactId>
      <version>${axe-core-playwright.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>guide-app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Browser*Test needs a browser download and runs only under -P browser (ADR-0014). -->
          <excludes>
            <exclude>${browser.tests}</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- ./mvnw -pl app -P browser verify: the whole suite plus Browser*Test, in
         Chromium through Playwright against the running application (ADR-0014). Playwright downloads
         the browser on its first run; if it cannot start, the tests fail rather than skip. Surefire's
         tag filter was tried first and selected nothing either way, so the exclusion is by class
         name and the profile lifts it. -->
    <profile>
      <id>browser</id>
      <properties>
        <browser.tests>none</browser.tests>
      </properties>
    </profile>
    <!-- ./mvnw -P postgres verify: the same tests on PostgreSQL 17, the production database, instead
         of H2. A container per JVM via Testcontainers' JDBC URL; without a running Docker the context
         cannot start and the build fails, since a skipped check would pass silently. -->
    <profile>
      <id>postgres</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <spring.datasource.url>jdbc:tc:postgresql:17:///guide?TC_DAEMON=true</spring.datasource.url>
                <spring.datasource.driver-class-name>org.testcontainers.jdbc.ContainerDatabaseDriver</spring.datasource.driver-class-name>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
