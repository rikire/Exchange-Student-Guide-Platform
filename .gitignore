# IDE
.idea/
*.iml
# Editor config is shared so both of us get the same JDK and formatting;
# git cannot re-include a file under an excluded directory, hence .vscode/* not .vscode/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node
node_modules/
dist/
build/
.next/
out/
coverage/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Java
*.class
target/
*.jar

# Misc
*.tmp
*.bak

# Maven wrapper jar — downloaded on first run of ./mvnw, not committed
.mvn/wrapper/maven-wrapper.jar

# Journal state: per-session working files for the prompt journal.
# The journal itself (docs/ai/journal/) is committed; this is scratch.
.claude/.journal-state/
.claude/settings.local.json

# Local runtime data
/data/
