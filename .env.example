# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Moderator login (ADR-0009): one shared password for the OGE office, stored only as its BCrypt
# hash. Choose the password, then make the hash with
#   htpasswd -bnBC 10 "" 'the password' | tr -d ':\n'
# and paste it here in single quotes. Left empty, no password logs in and /moderate stays closed.
GUIDE_ADMIN_PASSWORD_HASH=

# Submissions one client address may send per hour (NFR-005). Raise it only for a manual test,
# where one person sends many from the same address; left unset, the stand allows 5.
# GUIDE_CONTRIBUTE_SUBMISSIONLIMIT_REQUESTS=1000

# Upload limits (NFR-001): one file of each kind, and every stored file together. Sizes as Spring
# reads them (10MB, 1GB); left unset, the stand uses the values below. The largest per-file limit
# is also the most the server reads of one form.
# GUIDE_MEDIA_PHOTOLIMIT=10MB
# GUIDE_MEDIA_DOCUMENTLIMIT=20MB
# GUIDE_MEDIA_VIDEOLIMIT=500MB
# GUIDE_MEDIA_VOLUMELIMIT=100GB

# How long the files of a rejected submission are kept before they are removed; left unset, 7 days.
# GUIDE_MEDIA_REJECTEDKEPTFOR=7d

# Behind an HTTPS reverse proxy (docs/handoff/install.md). Set all three together, or none: the
# proxy's own address as a regular expression (dots escaped), so that only it is believed about the
# visitor's address, and the session cookie marked Secure.
# GUIDE_FORWARD_HEADERS=native
# GUIDE_TRUSTED_PROXY=10\.1\.2\.3
# GUIDE_COOKIE_SECURE=true

# The time zone every page shows times in, as a region id; left unset, the stand uses India's.
# GUIDE_TIMEZONE=Asia/Kolkata

# Database. The dev profile uses H2 and ignores these.
POSTGRES_DB=guide
POSTGRES_USER=guide
POSTGRES_PASSWORD=

# Where uploaded media and the search index live, and the Spring profile, are set in
# docker-compose.yml rather than here: both paths are volumes there, and the stand always starts
# with the `seed` profile.
