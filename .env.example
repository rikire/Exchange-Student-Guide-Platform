# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Moderator login (ADR-0009): one shared password for the OGE office, stored only as its BCrypt
# hash. Choose the password, then make the hash with
#   htpasswd -bnBC 10 "" 'the password' | tr -d ':\n'
# and paste it here in single quotes. Left empty, no password logs in and /moderate stays closed.
GUIDE_ADMIN_PASSWORD_HASH=

# Database. The dev profile uses H2 and ignores these.
POSTGRES_DB=guide
POSTGRES_USER=guide
POSTGRES_PASSWORD=

# Where uploaded media and the search index live. Both are mounted as volumes in
# docker-compose.yml: neither survives a container restart otherwise.
GUIDE_MEDIA_PATH=/var/lib/guide/media
GUIDE_INDEX_PATH=/var/lib/guide/index

# Active Spring profile: dev (H2, seed content) or prod (PostgreSQL).
SPRING_PROFILES_ACTIVE=dev
